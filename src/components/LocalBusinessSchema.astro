---
import { site } from '../data/site';

interface Props {
  url?: string;
}
const { url } = Astro.props;
const businessUrl = url ?? new URL(Astro.url.pathname, site.url).toString();

const dayMap: Record<string, string> = {
  Sun: 'Sunday', Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday',
};

// Service offers — surface in OfferCatalog so Google sees the full service list.
const offers = [
  { name: 'Classic Haircut', price: 25 },
  { name: 'Deluxe Haircut', price: 35 },
  { name: 'Buzz Cut', price: 15 },
  { name: "Kids' Cut", price: 20 },
  { name: 'Beard Trim', price: 20 },
  { name: 'Hot Towel Shave', price: 35 },
  { name: 'Straight Razor Trim', price: 25 },
  { name: 'Mustache Trim', price: 15 },
  { name: 'Hair Color', price: 25 },
  { name: 'Full Facial', price: 35 },
  { name: 'Hair Wash & Blow', price: 20 },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['HairSalon', 'BarberShop', 'LocalBusiness'],
  '@id': `${site.url}#business`,
  name: site.name,
  alternateName: ['Tamara Salon Qatar', 'Tamara Men Doha', 'Tamara Barbershop Doha'],
  legalName: site.legalName,
  url: businessUrl,
  image: [
    new URL('/og-image.png', site.url).toString(),
    new URL('/icon-512.png', site.url).toString(),
  ],
  logo: new URL('/icon-512.png', site.url).toString(),
  description:
    "Tamara Men Salon — premium men's grooming, precision haircuts, beard trims, hot towel shaves and styling on B Ring Road in Doha, Qatar. Walk-ins welcome.",
  slogan: 'We Know Your Style Better',
  telephone: site.phoneIntl,
  email: site.email,
  priceRange: '$$',
  currenciesAccepted: 'QAR',
  paymentAccepted: 'Cash, Credit Card, Debit Card',
  foundingDate: site.established,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  hasMap: site.mapsUrl,
  areaServed: [
    { '@type': 'Country', name: 'Qatar' },
    { '@type': 'City', name: 'Doha' },
    { '@type': 'City', name: 'Al Rayyan' },
    { '@type': 'City', name: 'Lusail' },
    { '@type': 'City', name: 'Al Wakrah' },
  ],
  openingHoursSpecification: site.openingHours.map((slot) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: slot.days.map((d) => `https://schema.org/${dayMap[d]}`),
    opens: slot.opens,
    closes: slot.closes,
  })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.score,
    reviewCount: site.rating.count,
    bestRating: '5',
    worstRating: '1',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: "Men's salon services",
    itemListElement: offers.map((o) => ({
      '@type': 'Offer',
      price: o.price,
      priceCurrency: 'QAR',
      itemOffered: {
        '@type': 'Service',
        name: o.name,
        provider: { '@id': `${site.url}#business` },
        areaServed: { '@type': 'City', name: 'Doha' },
      },
    })),
  },
  knowsAbout: [
    "men's haircuts",
    'beard grooming',
    'hot towel shave',
    'straight razor shave',
    'kids haircut',
    'hair color for men',
    'mustache trim',
    'scalp treatment',
  ],
  sameAs: [
    site.social.instagram,
    site.social.facebook,
    site.social.tiktok,
    site.social.googleReview,
  ].filter(Boolean),
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
