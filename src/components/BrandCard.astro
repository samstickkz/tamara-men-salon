---
import Icon from './Icon.astro';
import Bubbles from './Bubbles.astro';
import type { Brand } from '../data/brands';

interface Props { brand: Brand }
const { brand } = Astro.props;

// Each accent gets its own surface treatment so the two brands feel distinct
// while still living inside the Tamara visual system.
const styles =
  brand.accent === 'navy'
    ? {
        wrapper: 'bg-navy-900 text-white',
        body: 'text-white/85',
        badge: 'bg-accent-500 text-ink',
        primary:
          'bg-accent-500 hover:bg-accent-400 text-ink',
        secondary:
          'bg-white/10 hover:bg-white/20 text-white border border-white/20',
        accentText: 'text-accent-300',
      }
    : {
        wrapper: 'bg-brand-50 text-ink',
        body: 'text-ink-soft',
        badge: 'bg-brand-600 text-white',
        primary: 'bg-brand-600 hover:bg-brand-700 text-white',
        secondary:
          'bg-white hover:bg-slate-50 text-ink border border-slate-200',
        accentText: 'text-brand-600',
      };
---
<article class:list={['relative isolate overflow-hidden rounded-3xl p-8 sm:p-10 shadow-xl flex flex-col', styles.wrapper]}>
  {brand.accent === 'navy' && (
    <Bubbles class="absolute -top-12 -right-12 w-[400px] h-[420px]" variant="light" />
  )}

  <div class="relative flex items-start justify-between gap-4 flex-wrap">
    {brand.badge && (
      <span class:list={['inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider', styles.badge]}>
        {brand.badge}
      </span>
    )}
    <span class:list={['text-xs uppercase tracking-[0.2em] font-semibold', styles.accentText]}>
      Also From Our Team
    </span>
  </div>

  <div class="relative mt-6 flex-1">
    <h3 class="font-display text-3xl sm:text-4xl font-extrabold leading-tight">{brand.name}</h3>
    <p class:list={['mt-3 font-display text-lg sm:text-xl font-semibold leading-snug', styles.accentText]}>
      {brand.tagline}
    </p>
    <p class:list={['mt-4 leading-relaxed', styles.body]}>{brand.description}</p>
  </div>

  <div class="relative mt-7 flex flex-col sm:flex-row gap-3">
    <a
      href={brand.cta.href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-bold uppercase tracking-wide text-sm shadow-md transition-colors',
        styles.primary,
      ]}
    >
      {brand.cta.label}
      <Icon name="arrowRight" size={16} />
    </a>
    {
      brand.secondaryCta && (
        <a
          href={brand.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-bold uppercase tracking-wide text-sm transition-colors',
            styles.secondary,
          ]}
        >
          {brand.secondaryCta.label}
        </a>
      )
    }
  </div>
</article>
