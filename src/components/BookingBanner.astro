---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Bubbles from './Bubbles.astro';
import { site, whatsappLink } from '../data/site';
import { services } from '../data/services';
---
<section class="relative isolate overflow-hidden bg-brand-600 text-white">
  <Bubbles class="absolute -top-12 -right-12 w-[420px] h-[520px]" variant="light" />
  <Bubbles class="absolute -bottom-12 -left-12 w-[340px] h-[440px]" variant="light" />
  <div class="container-page relative py-16 sm:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] font-semibold text-accent-300">
          <span class="inline-block h-px w-8 bg-accent-300"></span>
          Book An Appointment
        </p>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold leading-tight">
          Book your next clean<br/>in under two minutes.
        </h2>
        <p class="mt-5 text-white/85 max-w-md leading-relaxed">
          Pick a service, share your area, and we'll respond on WhatsApp with a
          flat-rate quote — usually within an hour during opening times.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <WhatsAppButton variant="inverse" size="lg" label="Book on WhatsApp" />
          <a
            href={`tel:${site.phoneIntl}`}
            class="inline-flex items-center gap-3 text-white hover:text-accent-300 transition-colors"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-accent-300">
              <Icon name="phone" size={20} />
            </span>
            <span class="font-bold tracking-wide">{site.phone}</span>
          </a>
        </div>
      </div>

      <form
        name="booking"
        method="POST"
        action="/api/submit"
        class="relative bg-white text-ink rounded-3xl p-6 sm:p-8 shadow-2xl space-y-4"
      >
        <input type="hidden" name="form-name" value="booking" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>
        <h3 class="font-display text-xl font-bold text-ink">Request a quote</h3>

        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Your name</span>
            <input
              name="name"
              type="text"
              required
              class="mt-1 block w-full rounded-lg border border-slate-200 px-3 py-2.5 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
            />
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Phone / WhatsApp</span>
            <input
              name="phone"
              type="tel"
              required
              placeholder="+974 ..."
              class="mt-1 block w-full rounded-lg border border-slate-200 px-3 py-2.5 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Service</span>
          <select
            name="service"
            class="mt-1 block w-full rounded-lg border border-slate-200 px-3 py-2.5 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
          >
            <option value="">Choose a service</option>
            {services.map((s) => <option value={s.shortTitle}>{s.shortTitle}</option>)}
          </select>
        </label>

        <label class="block">
          <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Area / property notes</span>
          <textarea
            name="message"
            rows="3"
            placeholder="e.g. 2BR apartment in The Pearl, Friday morning"
            class="mt-1 block w-full rounded-lg border border-slate-200 px-3 py-2.5 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
          ></textarea>
        </label>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-accent-500 hover:bg-accent-400 text-ink font-bold uppercase tracking-wide text-sm shadow-md transition-colors"
        >
          Send Request
          <Icon name="arrowRight" size={16} />
        </button>
        <p class="text-xs text-ink-muted text-center">
          We reply on WhatsApp within a few hours. CR {site.cr}.
        </p>
      </form>
    </div>
  </div>
</section>
