---
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
import { site } from '../data/site';

const navItems = [
  { href: '#home', en: 'Home', ar: 'الرئيسية' },
  { href: '#services', en: 'Services', ar: 'خدماتنا' },
  { href: '#gallery', en: 'Gallery', ar: 'المعرض' },
  { href: '#team', en: 'Team', ar: 'الفريق' },
  { href: '#pricing', en: 'Pricing', ar: 'الأسعار' },
  { href: '#book', en: 'Book', ar: 'احجز' },
];
---
<header class="sticky top-0 z-40 bg-cream-50/95 backdrop-blur border-b border-charcoal-100">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <a href="#home" class="shrink-0 flex items-center">
        <img
          src="/logo.svg"
          alt="Tamara Men Salon"
          width="220"
          height="68"
          class="h-12 lg:h-14 w-auto"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="hidden xl:flex items-center gap-1" aria-label="Primary" id="primary-nav">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-nav-link={item.href}
              data-i18n-en={item.en}
              data-i18n-ar={item.ar}
              class="px-3 py-2 font-condensed uppercase tracking-widest text-[13px] text-charcoal-700 hover:text-gold-600 transition-colors"
            >
              {item.en}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <LangToggle />

        <a
          href={`tel:${site.phoneIntl}`}
          class="hidden md:inline-flex items-center gap-2 text-charcoal-700 hover:text-gold-600 transition-colors"
        >
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gold-500 text-gold-500">
            <Icon name="phone" size={18} />
          </span>
          <span class="flex flex-col leading-tight text-left">
            <span class="text-[10px] uppercase tracking-widest text-ink-muted font-condensed" data-i18n-en="Call Us" data-i18n-ar="اتصل بنا">Call Us</span>
            <span class="font-semibold text-sm text-charcoal-700">{site.phone}</span>
          </span>
        </a>

        <a href="#book" class="hidden sm:inline-flex btn-primary !py-3 !px-5">
          <span data-i18n-en="Book Appointment" data-i18n-ar="احجز موعدك">Book Appointment</span>
        </a>

        <button
          type="button"
          id="mobile-nav-toggle"
          class="xl:hidden inline-flex items-center justify-center h-11 w-11 text-charcoal-700 hover:text-gold-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500"
          aria-controls="mobile-nav"
          aria-expanded="false"
        >
          <span class="sr-only">Open menu</span>
          <Icon name="menu" size={26} />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="xl:hidden hidden border-t border-charcoal-100 bg-cream-50">
    <nav class="max-w-container mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            data-i18n-en={item.en}
            data-i18n-ar={item.ar}
            class="px-3 py-2.5 font-condensed uppercase tracking-widest text-sm text-charcoal-700 hover:text-gold-600 hover:bg-cream-100"
          >
            {item.en}
          </a>
        ))
      }
      <a
        href={`tel:${site.phoneIntl}`}
        class="mt-2 pt-3 border-t border-charcoal-100 flex items-center gap-2 px-3 py-2 text-sm font-medium text-charcoal-700"
      >
        <Icon name="phone" size={18} class="text-gold-500" />
        <span>{site.phone}</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }

  // Active-section nav highlighting via IntersectionObserver
  const navLinks = Array.from(document.querySelectorAll('[data-nav-link]')) as HTMLAnchorElement[];
  const sectionIds = Array.from(new Set(navLinks.map((a) => a.getAttribute('data-nav-link') || ''))).filter(Boolean);
  const sections = sectionIds
    .map((id) => document.querySelector(id))
    .filter((el): el is Element => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === id;
        link.classList.toggle('nav-active', isActive);
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        // Pick the most visible intersecting section
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive('#' + visible.target.id);
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
