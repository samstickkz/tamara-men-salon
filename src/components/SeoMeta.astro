---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og-image.png',
  type = 'website',
  noindex = false,
  keywords,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
---
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonicalUrl} />
{noindex ? (
  <meta name="robots" content="noindex,nofollow" />
) : (
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
)}

<!-- Multilingual variants -->
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="ar" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- Geo signals for local SEO (Doha, Qatar) -->
<meta name="geo.region" content={`${site.address.addressCountry}-DA`} />
<meta name="geo.placename" content={site.address.addressLocality} />
<meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
<meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />
<meta name="author" content={site.name} />
<meta name="publisher" content={site.name} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Tamara Men Salon — Premium men's grooming in Doha, Qatar" />
<meta property="og:locale" content="en_QA" />
<meta property="og:locale:alternate" content="ar_QA" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Tamara Men Salon — Doha, Qatar" />
