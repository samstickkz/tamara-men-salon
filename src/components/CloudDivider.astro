---
// Bumpy cloud-shaped section divider — sits at the bottom of a coloured section
// and transitions into white. Position the parent `relative` and absolute the
// divider with `bottom-0 left-0 right-0`.
interface Props {
  fill?: string; // colour the cloud fills with (the next section's background)
  class?: string;
  flip?: boolean; // flip vertically to use at the top of a section
}
const { fill = '#ffffff', class: className = '', flip = false } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1440 110"
  preserveAspectRatio="none"
  class={`block w-full h-[60px] sm:h-[90px] ${flip ? 'rotate-180' : ''} ${className}`}
  aria-hidden="true"
>
  <path
    fill={fill}
    d="M0,110 L0,70 C40,70 60,40 100,40 C140,40 160,75 200,75 C240,75 260,30 320,30 C380,30 400,75 460,75 C520,75 540,25 600,25 C660,25 680,80 740,80 C800,80 820,35 880,35 C940,35 960,80 1020,80 C1080,80 1100,30 1160,30 C1220,30 1240,75 1300,75 C1340,75 1360,50 1400,50 C1420,50 1430,60 1440,70 L1440,110 Z"
  ></path>
</svg>
