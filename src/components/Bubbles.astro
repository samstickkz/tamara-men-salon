---
// Sparse, shiny soap-bubble cluster — radial-gradient fill + small white
// highlight on each bubble for a glossy look. Drop into a `relative` parent.
interface Props {
  class?: string;
  variant?: 'light' | 'dark';
  density?: 'sparse' | 'normal';
}
const { class: className = '', variant = 'light', density = 'sparse' } = Astro.props;

// Each bubble: [cx, cy, r]
const sparseSet = [
  [80, 100, 36],
  [200, 60, 18],
  [300, 140, 26],
  [110, 220, 14],
  [240, 280, 30],
  [40, 320, 20],
  [320, 360, 16],
];
const normalSet = [
  ...sparseSet,
  [160, 160, 10],
  [260, 200, 12],
  [60, 400, 28],
  [200, 460, 16],
  [330, 460, 22],
];
const set = (density === 'sparse' ? sparseSet : normalSet);

const palette = variant === 'light'
  ? {
      stroke: 'rgba(255,255,255,0.7)',
      gradStart: 'rgba(255,255,255,0.45)',
      gradMid:   'rgba(255,255,255,0.18)',
      gradEnd:   'rgba(255,255,255,0.06)',
      shine:     'rgba(255,255,255,0.85)',
    }
  : {
      stroke: 'rgba(30,91,251,0.55)',
      gradStart: 'rgba(255,255,255,0.85)',
      gradMid:   'rgba(219,230,254,0.45)',
      gradEnd:   'rgba(30,91,251,0.08)',
      shine:     'rgba(255,255,255,1)',
    };

// Stable, deterministic gradient id per render so multiple instances on the
// same page don't collide.
const uid = Math.random().toString(36).slice(2, 8);
const gradId = `bubble-grad-${variant}-${uid}`;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 520"
  class={`pointer-events-none ${className}`}
  aria-hidden="true"
>
  <defs>
    <radialGradient id={gradId} cx="35%" cy="32%" r="70%">
      <stop offset="0" stop-color={palette.gradStart}/>
      <stop offset="55%" stop-color={palette.gradMid}/>
      <stop offset="100%" stop-color={palette.gradEnd}/>
    </radialGradient>
  </defs>
  {
    set.map(([cx, cy, r]) => (
      <g>
        <circle cx={cx} cy={cy} r={r} fill={`url(#${gradId})`} stroke={palette.stroke} stroke-width="1.4"/>
        <ellipse
          cx={Number(cx) - Number(r) * 0.35}
          cy={Number(cy) - Number(r) * 0.45}
          rx={Number(r) * 0.28}
          ry={Number(r) * 0.18}
          fill={palette.shine}
          opacity="0.7"
        />
        <circle
          cx={Number(cx) + Number(r) * 0.45}
          cy={Number(cy) - Number(r) * 0.1}
          r={Math.max(1.5, Number(r) * 0.05)}
          fill={palette.shine}
          opacity="0.55"
        />
      </g>
    ))
  }
</svg>
