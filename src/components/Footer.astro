---
import Icon from './Icon.astro';
import { site, whatsappLink, mailtoLink } from '../data/site';

const year = new Date().getFullYear();

const navItems = [
  { href: '#home', en: 'Home', ar: 'الرئيسية' },
  { href: '#services', en: 'Services', ar: 'خدماتنا' },
  { href: '#gallery', en: 'Gallery', ar: 'المعرض' },
  { href: '#team', en: 'Team', ar: 'الفريق' },
  { href: '#pricing', en: 'Pricing', ar: 'الأسعار' },
  { href: '#book', en: 'Book', ar: 'احجز' },
];
---
<footer class="bg-charcoal-800 text-cream-100">
  <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col items-center text-center">
      <img
        src="/logo.svg"
        alt="Tamara Men Salon"
        width="280"
        height="86"
        loading="lazy"
        decoding="async"
        class="h-16 w-auto invert brightness-200 contrast-75"
      />
      <p class="mt-5 max-w-xl text-sm text-cream-100/70 font-sans" data-i18n-en="Premium men's grooming in Doha — precision haircuts, hot towel shaves, beard styling and skin care." data-i18n-ar="عناية رجالية فاخرة في الدوحة — قصات دقيقة، حلاقة بالمناشف الساخنة، تنسيق اللحية والعناية بالبشرة.">
        Premium men's grooming in Doha — precision haircuts, hot towel shaves, beard styling and skin care.
      </p>

      <nav class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3" aria-label="Footer">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-i18n-en={item.en}
              data-i18n-ar={item.ar}
              class="font-condensed uppercase tracking-widest text-xs text-cream-100/75 hover:text-gold-400 transition-colors"
            >
              {item.en}
            </a>
          ))
        }
      </nav>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-5 text-sm">
        <a href={`tel:${site.phoneIntl}`} class="inline-flex items-center gap-2 text-cream-100 hover:text-gold-400">
          <Icon name="phone" size={16} class="text-gold-400" />
          <span>{site.phone}</span>
        </a>
        <a href={mailtoLink()} class="inline-flex items-center gap-2 text-cream-100 hover:text-gold-400">
          <Icon name="email" size={16} class="text-gold-400" />
          <span>{site.email}</span>
        </a>
        <span class="inline-flex items-center gap-2 text-cream-100/80">
          <Icon name="mapPin" size={16} class="text-gold-400" />
          <span data-i18n-en="Doha, Qatar" data-i18n-ar="الدوحة، قطر">Doha, Qatar</span>
        </span>
      </div>

      <div class="mt-8 flex items-center gap-3">
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="inline-flex h-10 w-10 items-center justify-center border border-cream-100/30 hover:border-gold-400 hover:text-gold-400 transition-colors"
        >
          <Icon name="instagram" size={18} />
        </a>
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="inline-flex h-10 w-10 items-center justify-center border border-cream-100/30 hover:border-gold-400 hover:text-gold-400 transition-colors"
        >
          <Icon name="facebook" size={18} />
        </a>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="inline-flex h-10 w-10 items-center justify-center border border-cream-100/30 hover:border-gold-400 hover:text-gold-400 transition-colors"
        >
          <Icon name="whatsapp" size={18} />
        </a>
        <a
          href={site.social.googleReview}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Review on Google"
          class="inline-flex h-10 w-10 items-center justify-center border border-cream-100/30 hover:border-gold-400 hover:text-gold-400 transition-colors"
        >
          <Icon name="google" size={18} />
        </a>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-cream-100/10 text-center text-xs text-cream-100/50">
      <p>© {year} {site.legalName}. <span data-i18n-en="All rights reserved. — Crafted in Doha, Qatar." data-i18n-ar="جميع الحقوق محفوظة. — صُنع في الدوحة، قطر.">All rights reserved. — Crafted in Doha, Qatar.</span></p>
    </div>
  </div>
</footer>
