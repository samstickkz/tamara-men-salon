---
import Icon from './Icon.astro';
import type { Faq as FaqItem } from '../data/faqs';

interface Props {
  items: FaqItem[];
  heading?: string;
  intro?: string;
}
const { items, heading = 'Frequently asked questions', intro } = Astro.props;
---
<section class="relative isolate py-16 sm:py-24 bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <header class="text-center">
      <p class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] font-semibold text-brand-600">
        <span class="inline-block h-px w-8 bg-brand-600"></span>
        FAQ
        <span class="inline-block h-px w-8 bg-brand-600"></span>
      </p>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold text-ink">{heading}</h2>
      {intro && <p class="mt-3 text-ink-soft">{intro}</p>}
    </header>

    <div class="mt-10 space-y-3">
      {
        items.map((item, idx) => (
          <details
            class="group bg-white rounded-2xl border border-slate-200 open:shadow-lg open:border-brand-200 transition-all"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none">
              <h3 class="font-display text-base font-bold text-ink">{item.q}</h3>
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-transform group-open:rotate-180 group-open:bg-brand-600 group-open:text-white">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <div class="px-5 pb-5 text-ink-soft leading-relaxed">{item.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>
