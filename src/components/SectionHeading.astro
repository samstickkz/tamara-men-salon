---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
  as?: 'h2' | 'h3';
}
const { eyebrow, title, intro, center = false, as: Tag = 'h2' } = Astro.props;
---
<header class:list={['max-w-2xl', center ? 'mx-auto text-center' : '']}>
  {
    eyebrow && (
      <p class="font-semibold text-sm uppercase tracking-wider text-brand-700">{eyebrow}</p>
    )
  }
  <Tag class="mt-2 font-display text-3xl sm:text-4xl font-bold text-ink">{title}</Tag>
  {intro && <p class="mt-4 text-lg text-ink-soft leading-relaxed">{intro}</p>}
</header>
