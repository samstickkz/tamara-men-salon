---
import WhatsAppButton from './WhatsAppButton.astro';
import { site, mailtoLink } from '../data/site';
import Icon from './Icon.astro';
import Bubbles from './Bubbles.astro';

interface Props {
  title?: string;
  subtitle?: string;
  message?: string;
}
const {
  title = 'Ready for a sparkling clean property?',
  subtitle = 'Get a quote in minutes on WhatsApp — share a few photos and we will price it on the spot.',
  message,
} = Astro.props;
---
<section class="relative isolate overflow-hidden bg-brand-600 text-white">
  <Bubbles class="absolute -top-10 -right-12 w-[420px] h-[500px]" variant="light" />
  <Bubbles class="absolute -bottom-12 -left-12 w-[320px] h-[400px]" variant="light" />
  <div class="absolute inset-0 -z-10 opacity-25" aria-hidden="true">
    <div class="absolute -top-20 -right-20 h-80 w-80 rounded-full bg-accent-400 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 h-96 w-96 rounded-full bg-brand-800 blur-3xl"></div>
  </div>
  <div class="container-page relative py-16 sm:py-20">
    <div class="grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] font-semibold text-accent-300">
          <span class="inline-block h-px w-8 bg-accent-300"></span>
          Get Started
        </p>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold">{title}</h2>
        <p class="mt-4 text-lg text-white/90 leading-relaxed max-w-xl">{subtitle}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
        <WhatsAppButton variant="inverse" size="lg" label="Chat on WhatsApp" message={message} />
        <a
          href={mailtoLink('Cleaning quote request')}
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-accent-500 hover:bg-accent-400 text-ink font-bold uppercase tracking-wide text-sm shadow-md transition-colors"
        >
          <Icon name="email" size={20} />
          <span class="normal-case tracking-normal">{site.email}</span>
        </a>
      </div>
    </div>
  </div>
</section>
