---
// Stylized cleaning-pro SVG illustration for the hero. Friendly, energetic,
// avoids the need for real photography.
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 520 600"
  class="w-full h-auto drop-shadow-2xl"
  role="img"
  aria-label="Friendly cleaning professional with cleaning supplies"
>
  <defs>
    <linearGradient id="hi-uniform" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#1A4ADB"/>
      <stop offset="1" stop-color="#102357"/>
    </linearGradient>
    <linearGradient id="hi-bucket" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#FFCA1F"/>
      <stop offset="1" stop-color="#E29400"/>
    </linearGradient>
    <radialGradient id="hi-shadow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="rgba(0,0,0,0.25)"/>
      <stop offset="1" stop-color="rgba(0,0,0,0)"/>
    </radialGradient>
  </defs>

  <!-- ground shadow -->
  <ellipse cx="260" cy="560" rx="170" ry="22" fill="url(#hi-shadow)"/>

  <!-- bucket with sponge -->
  <g transform="translate(60,360)">
    <path d="M0 30 L20 170 L150 170 L170 30 Z" fill="url(#hi-bucket)"/>
    <ellipse cx="85" cy="30" rx="85" ry="14" fill="#FFDB46"/>
    <ellipse cx="85" cy="30" rx="65" ry="10" fill="#1E5BFB" opacity="0.15"/>
    <rect x="40" y="14" width="90" height="22" rx="6" fill="#FFFFFF"/>
    <rect x="45" y="20" width="80" height="10" rx="3" fill="#FFCA1F" opacity="0.6"/>
    <path d="M-10 0 q90 -40 190 0" stroke="#FFCA1F" stroke-width="6" fill="none"/>
  </g>

  <!-- body -->
  <g transform="translate(160,160)">
    <!-- legs -->
    <rect x="40" y="270" width="55" height="120" rx="14" fill="url(#hi-uniform)"/>
    <rect x="105" y="270" width="55" height="120" rx="14" fill="url(#hi-uniform)"/>
    <!-- shoes -->
    <rect x="30" y="380" width="70" height="20" rx="8" fill="#0B1733"/>
    <rect x="100" y="380" width="70" height="20" rx="8" fill="#0B1733"/>
    <!-- apron / shirt -->
    <path d="M10 120 L10 290 L190 290 L190 120 C 190 70, 150 50, 100 50 C 50 50, 10 70, 10 120 Z" fill="url(#hi-uniform)"/>
    <!-- white shirt collar peeking -->
    <path d="M70 60 L130 60 L130 95 L100 110 L70 95 Z" fill="#FFFFFF"/>
    <!-- belt -->
    <rect x="10" y="240" width="180" height="14" fill="#0B1733"/>
    <rect x="92" y="240" width="16" height="14" fill="#FFCA1F"/>
    <!-- arms -->
    <rect x="-30" y="120" width="55" height="140" rx="20" fill="url(#hi-uniform)" transform="rotate(-12 -5 190)"/>
    <rect x="175" y="120" width="55" height="160" rx="20" fill="url(#hi-uniform)" transform="rotate(18 200 200)"/>
    <!-- gloves -->
    <circle cx="-15" cy="265" r="26" fill="#FFCA1F"/>
    <circle cx="225" cy="282" r="26" fill="#FFCA1F"/>
    <!-- thumb-up sign in right glove -->
    <path d="M218 252 q10 -10 20 0 l-2 18 l-12 4 z" fill="#FFCA1F"/>
    <!-- spray bottle held in left glove -->
    <g transform="translate(-50,250) rotate(-10)">
      <rect x="0" y="0" width="34" height="48" rx="6" fill="#FFFFFF"/>
      <rect x="4" y="14" width="26" height="22" fill="#1E5BFB" opacity="0.85"/>
      <path d="M14 -10 h12 v10 h-12 z" fill="#FFFFFF"/>
      <path d="M26 -6 l16 -10 l4 4 l-16 12 z" fill="#FFFFFF"/>
    </g>
    <!-- head -->
    <ellipse cx="100" cy="40" rx="48" ry="50" fill="#F2C998"/>
    <!-- hair -->
    <path d="M52 30 q20 -38 96 -14 q-8 -28 -48 -30 q-50 -2 -48 44 z" fill="#1F3A5F"/>
    <!-- ear -->
    <ellipse cx="50" cy="44" rx="6" ry="9" fill="#E2A872"/>
    <!-- smile -->
    <path d="M84 56 q16 14 32 0" stroke="#0B1733" stroke-width="3" fill="none" stroke-linecap="round"/>
    <!-- eyes -->
    <circle cx="84" cy="38" r="3.5" fill="#0B1733"/>
    <circle cx="118" cy="38" r="3.5" fill="#0B1733"/>
    <!-- blush -->
    <circle cx="74" cy="52" r="6" fill="#F08080" opacity="0.35"/>
    <circle cx="128" cy="52" r="6" fill="#F08080" opacity="0.35"/>
  </g>

  <!-- floating bubbles around figure -->
  <g fill="none" stroke="#FFFFFF" stroke-width="2" opacity="0.9">
    <circle cx="420" cy="90" r="22"/>
    <circle cx="470" cy="160" r="12"/>
    <circle cx="60" cy="180" r="14"/>
    <circle cx="40" cy="280" r="10"/>
    <circle cx="460" cy="380" r="18"/>
  </g>
</svg>
