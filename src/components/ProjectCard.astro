---
import Icon from './Icon.astro';
import type { Project } from '../data/marketing';

interface Props { project: Project }
const { project } = Astro.props;

// SVG fallbacks if a remote photo ever fails — defined in CSS via background.
const fallbacks: Record<Project['fallback'], string> = {
  villa: `linear-gradient(135deg, #1E5BFB, #102357)`,
  apartment: `linear-gradient(135deg, #0C1928, #1A4ADB)`,
  office: `linear-gradient(135deg, #608CFB, #1E5BFB)`,
  postCon: `linear-gradient(135deg, #FFCA1F, #FFB800)`,
  sofa: `linear-gradient(135deg, #1A4ADB, #FFCA1F)`,
  kitchen: `linear-gradient(135deg, #DBE6FE, #1E5BFB)`,
};
const fallbackBg = fallbacks[project.fallback];
---
<a href="/services" class="group block rounded-3xl overflow-hidden bg-white shadow-lg hover:shadow-2xl transition-shadow">
  <div class="relative aspect-[10/7] overflow-hidden" style={`background-image: ${fallbackBg};`}>
    <img
      src={project.image}
      alt={`${project.category} project in ${project.area}, Qatar`}
      loading="lazy"
      decoding="async"
      width="900"
      height="630"
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.style.display='none'"
    />
    <!-- subtle gradient overlay for legibility -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
    <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/95 text-brand-700 text-xs font-bold uppercase tracking-wider shadow">
      {project.category}
    </span>
    <span class="absolute bottom-4 right-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-accent-500 text-ink shadow-lg group-hover:rotate-45 transition-transform">
      <Icon name="arrowRight" size={20} />
    </span>
  </div>
  <div class="p-6">
    <h3 class="font-display text-lg font-bold text-ink leading-tight group-hover:text-brand-600 transition-colors">
      {project.title}
    </h3>
    <p class="mt-2 text-sm text-ink-muted flex items-center gap-1.5">
      <Icon name="mapPin" size={14} />
      {project.area}
    </p>
  </div>
</a>
