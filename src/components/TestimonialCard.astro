---
import Icon from './Icon.astro';

interface Props {
  quote: string;
  name: string;
  role: string;
  rating?: number;
}
const { quote, name, role, rating = 5 } = Astro.props;
const stars = Array.from({ length: rating });
---
<figure class="flex flex-col h-full p-6 bg-white rounded-2xl border border-sand-200 shadow-card">
  <div class="flex items-center gap-1 text-amber-500" aria-label={`${rating} out of 5 stars`}>
    {stars.map(() => <Icon name="star" size={18} class="fill-amber-500" />)}
  </div>
  <blockquote class="mt-4 text-ink-soft leading-relaxed flex-1">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="mt-5 pt-5 border-t border-sand-200">
    <div class="font-semibold text-ink">{name}</div>
    <div class="text-sm text-ink-muted">{role}</div>
  </figcaption>
</figure>
