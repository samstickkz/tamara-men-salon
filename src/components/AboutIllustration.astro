---
// Stylized SVG illustration cluster — three circular vignettes arranged
// like the template's photo grid, but built as flat illustrations.
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 520 520"
  class="w-full h-auto"
  role="img"
  aria-label="Illustrations of professional cleaning at homes and offices"
>
  <defs>
    <clipPath id="ai-c1"><circle cx="170" cy="160" r="120"/></clipPath>
    <clipPath id="ai-c2"><circle cx="380" cy="200" r="80"/></clipPath>
    <clipPath id="ai-c3"><circle cx="200" cy="380" r="100"/></clipPath>
    <clipPath id="ai-c4"><circle cx="400" cy="380" r="65"/></clipPath>

    <linearGradient id="ai-bg1" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#DBE6FE"/>
      <stop offset="1" stop-color="#93B4FD"/>
    </linearGradient>
    <linearGradient id="ai-bg2" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#FFF6C5"/>
      <stop offset="1" stop-color="#FFDB46"/>
    </linearGradient>
    <linearGradient id="ai-bg3" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#DBE6FE"/>
      <stop offset="1" stop-color="#608CFB"/>
    </linearGradient>
    <linearGradient id="ai-bg4" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="#FFEC85"/>
      <stop offset="1" stop-color="#FFB800"/>
    </linearGradient>
  </defs>

  <!-- ring 1 — kitchen scene -->
  <g clip-path="url(#ai-c1)">
    <rect x="50" y="40" width="240" height="240" fill="url(#ai-bg1)"/>
    <!-- counter -->
    <rect x="50" y="200" width="240" height="40" fill="#FFFFFF"/>
    <!-- pot -->
    <rect x="110" y="170" width="50" height="35" rx="4" fill="#1E5BFB"/>
    <rect x="105" y="166" width="60" height="8" rx="4" fill="#0B1733"/>
    <!-- spray bottle -->
    <rect x="195" y="155" width="22" height="44" rx="4" fill="#FFFFFF"/>
    <rect x="199" y="170" width="14" height="20" fill="#1E5BFB"/>
    <path d="M203 145 h6 v10 h-6 z" fill="#FFFFFF"/>
    <!-- person -->
    <circle cx="220" cy="120" r="22" fill="#F2C998"/>
    <rect x="200" y="140" width="40" height="60" rx="6" fill="#1A4ADB"/>
    <circle cx="214" cy="116" r="2" fill="#0B1733"/>
    <circle cx="226" cy="116" r="2" fill="#0B1733"/>
  </g>
  <circle cx="170" cy="160" r="120" fill="none" stroke="#FFFFFF" stroke-width="6"/>

  <!-- ring 2 — bubble/cleaning vignette -->
  <g clip-path="url(#ai-c2)">
    <rect x="300" y="120" width="160" height="160" fill="url(#ai-bg2)"/>
    <circle cx="370" cy="190" r="30" fill="#FFFFFF" opacity="0.85"/>
    <circle cx="410" cy="220" r="20" fill="#FFFFFF" opacity="0.6"/>
    <circle cx="350" cy="230" r="12" fill="#FFFFFF" opacity="0.6"/>
    <circle cx="395" cy="170" r="10" fill="#FFFFFF" opacity="0.6"/>
    <path d="M340 240 q40 -30 80 0" stroke="#1E5BFB" stroke-width="3" fill="none"/>
  </g>
  <circle cx="380" cy="200" r="80" fill="none" stroke="#FFFFFF" stroke-width="6"/>

  <!-- ring 3 — vacuum scene -->
  <g clip-path="url(#ai-c3)">
    <rect x="100" y="280" width="200" height="200" fill="url(#ai-bg3)"/>
    <!-- floor -->
    <rect x="100" y="420" width="200" height="60" fill="#FFFFFF" opacity="0.8"/>
    <!-- vacuum body -->
    <rect x="160" y="380" width="60" height="45" rx="8" fill="#1E5BFB"/>
    <rect x="170" y="395" width="40" height="20" fill="#FFFFFF" opacity="0.5"/>
    <!-- vacuum stick -->
    <rect x="184" y="320" width="12" height="65" fill="#0B1733"/>
    <!-- person -->
    <circle cx="240" cy="335" r="18" fill="#F2C998"/>
    <rect x="225" y="350" width="34" height="50" rx="6" fill="#FFCA1F"/>
    <circle cx="234" cy="332" r="2" fill="#0B1733"/>
    <circle cx="244" cy="332" r="2" fill="#0B1733"/>
  </g>
  <circle cx="200" cy="380" r="100" fill="none" stroke="#FFFFFF" stroke-width="6"/>

  <!-- ring 4 — bucket -->
  <g clip-path="url(#ai-c4)">
    <rect x="335" y="315" width="130" height="130" fill="url(#ai-bg4)"/>
    <path d="M370 380 L378 425 L432 425 L440 380 Z" fill="#1E5BFB"/>
    <ellipse cx="405" cy="380" rx="35" ry="6" fill="#1A4ADB"/>
    <path d="M370 380 q35 -22 70 0" stroke="#0B1733" stroke-width="3" fill="none"/>
    <circle cx="395" cy="365" r="6" fill="#FFFFFF" opacity="0.9"/>
    <circle cx="415" cy="358" r="4" fill="#FFFFFF" opacity="0.9"/>
  </g>
  <circle cx="400" cy="380" r="65" fill="none" stroke="#FFFFFF" stroke-width="6"/>

  <!-- accent dots -->
  <g fill="#FFB800">
    <circle cx="60" cy="60" r="6"/>
    <circle cx="480" cy="100" r="5"/>
    <circle cx="500" cy="450" r="6"/>
    <circle cx="100" cy="500" r="5"/>
  </g>
  <g fill="#1E5BFB">
    <circle cx="40" cy="320" r="4"/>
    <circle cx="490" cy="290" r="4"/>
  </g>
</svg>
