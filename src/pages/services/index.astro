---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { services } from '../../data/services';

const title = 'Cleaning Services in Doha, Qatar — Full List | Tamara Cleaning';
const description =
  'All cleaning services from Tamara Cleaning in Doha — villa, apartment, office, deep, move-in/out, post-construction, sofa, carpet, mattress, kitchen, bathroom, window, disinfection.';
---
<BaseLayout title={title} description={description}>
  <BreadcrumbSchema
    slot="head"
    items={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services' }]}
  />

  <PageHero
    eyebrow="Our Services"
    title="Every cleaning service we offer in Qatar"
    intro="From a weekly apartment refresh to one-off post-construction handover cleans. All services include supplies, eco-friendly products, and a vetted crew."
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Services' }]}
    iconName="sparkle"
  />

  <section class="relative isolate bg-white py-16 sm:py-24">
    <div class="container-page relative">
      <div class="text-center max-w-2xl mx-auto">
        <p class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] font-semibold text-brand-600">
          <span class="inline-block h-px w-8 bg-brand-600"></span>
          Choose What You Need
          <span class="inline-block h-px w-8 bg-brand-600"></span>
        </p>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold text-ink">
          11 specialist cleaning services across Qatar
        </h2>
        <p class="mt-4 text-ink-soft">
          Every service can be combined — for example, a deep clean with mattress and sofa extraction in the same visit.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <ServiceCard
              href={`/services/${service.slug}`}
              title={service.shortTitle}
              description={service.tagline}
              icon={service.icon}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner
    title="Not sure which service you need?"
    subtitle="WhatsApp us a couple of photos of the space — we will recommend the right service and quote a flat rate."
  />
</BaseLayout>
