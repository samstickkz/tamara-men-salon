---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const title = 'Page not found | Tamara Men Salon';
const description = "Sorry, we couldn't find that page. Head back to Tamara Men Salon's home.";
---
<BaseLayout title={title} description={description} noindex>
  <section class="bg-charcoal-800 text-cream-100 py-24 sm:py-32">
    <div class="container-page max-w-2xl text-center">
      <p class="font-display italic text-gold-400 text-xl">404</p>
      <h1 class="mt-3 font-condensed uppercase font-bold tracking-wide text-5xl sm:text-6xl">
        We couldn't find that page
      </h1>
      <p class="mt-4 text-cream-100/80">
        It may have moved, or the link is mistyped. Head back to home.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary">
          <Icon name="arrowRight" size={16} />
          Back to home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
