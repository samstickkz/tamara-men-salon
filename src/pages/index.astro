  <script is:inline define:vars={{ hoursByDay: site.hoursByDay }}>
    (function () {
      var form = document.getElementById('booking-form');
      if (!form) return;
      var errorEl = document.getElementById('booking-error');
      var hint = document.getElementById('time-hint');
      var dateInput = form.querySelector('input[name="date"]');
      var timeInput = form.querySelector('input[name="time"]');
      var serviceSelect = form.querySelector('select[name="service"]');
      var number = form.dataset.whatsappNumber;

      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      function toISODate(d) {
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      }

      // Min = today; default to today on first render
      var today = new Date();
      var todayStr = toISODate(today);
      if (dateInput) {
        dateInput.min = todayStr;
        if (!dateInput.value) dateInput.value = todayStr;
      }

      function applyTimeBoundsForDate() {
        if (!dateInput || !timeInput || !dateInput.value) return;
        var d = new Date(dateInput.value + 'T00:00:00');
        var dow = d.getDay();
        var slot = hoursByDay[dow] || hoursByDay[1];
        if (slot) {
          timeInput.min = slot.open;
          timeInput.max = slot.close;
          if (hint) {
            var lang = document.documentElement.lang === 'ar' ? 'ar' : 'en';
            hint.textContent = lang === 'ar'
              ? 'ساعات هذا اليوم: ' + slot.open + ' – ' + slot.close
              : 'Hours that day: ' + slot.open + ' – ' + slot.close;
          }
        }
        // If user already chose a time outside range, clear it
        if (timeInput.value && (timeInput.value < timeInput.min || timeInput.value > timeInput.max)) {
          timeInput.value = '';
        }
      }
      if (dateInput) dateInput.addEventListener('change', applyTimeBoundsForDate);
      applyTimeBoundsForDate();

      // Quick-book chips → pre-fill form fields
      var chips = document.querySelectorAll('.quick-chip');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var svc = chip.dataset.service;
          var offset = parseInt(chip.dataset.dayOffset || '0', 10);
          var time = chip.dataset.time;
          if (svc && serviceSelect) {
            var opt = Array.prototype.find.call(serviceSelect.options, function (o) {
              return o.value === svc || o.textContent === svc;
            });
            if (opt) serviceSelect.value = opt.value || opt.textContent;
          }
          if (dateInput) {
            var d = new Date();
            d.setDate(d.getDate() + offset);
            dateInput.value = toISODate(d);
            applyTimeBoundsForDate();
          }
          if (time && timeInput) {
            // Only apply if within hours
            if ((!timeInput.min || time >= timeInput.min) && (!timeInput.max || time <= timeInput.max)) {
              timeInput.value = time;
            } else {
              timeInput.value = timeInput.min || time;
            }
          }
          // Smooth-scroll form into view on mobile
          if (window.innerWidth < 768) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      function formatDate(value) {
        if (!value) return value;
        try {
          var d = new Date(value + 'T00:00:00');
          if (isNaN(d.getTime())) return value;
          var locale = document.documentElement.lang === 'ar' ? 'ar-QA' : 'en-GB';
          return d.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        } catch (_e) {
          return value;
        }
      }

      function formatTime(value) {
        if (!value) return value;
        var parts = value.split(':');
        if (parts.length < 2) return value;
        var h = parseInt(parts[0], 10);
        var m = parts[1];
        var ampm = h >= 12 ? 'PM' : 'AM';
        var hour = ((h + 11) % 12) + 1;
        return hour + ':' + m + ' ' + ampm;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var data = new FormData(form);
        var name = (data.get('name') || '').toString().trim();
        var service = (data.get('service') || '').toString().trim();
        var date = (data.get('date') || '').toString().trim();
        var time = (data.get('time') || '').toString().trim();
        var phone = (data.get('phone') || '').toString().trim();
        var notes = (data.get('notes') || '').toString().trim();

        if (!name || !service || !date || !time) {
          if (errorEl) errorEl.classList.remove('hidden');
          return;
        }
        if (errorEl) errorEl.classList.add('hidden');

        var lines = [
          'Hello Tamara Men Salon, I would like to book an appointment.',
          '',
          '• Name: ' + name,
          '• Service: ' + service,
          '• Date: ' + formatDate(date),
          '• Time: ' + formatTime(time),
        ];
        // Strip the "+974 " prefix if the user didn't type anything after it
        var phoneClean = phone.replace(/^\+?974\s*$/, '');
        if (phoneClean) lines.push('• Phone: ' + phone);
        if (notes) lines.push('• Notes: ' + notes);

        var url = 'https://wa.me/' + number + '?text=' + encodeURIComponent(lines.join('\n'));

        // Fire a GA4 conversion event so booking opens are tracked
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'booking_submit', {
            event_category: 'engagement',
            event_label: service,
            value: 1,
          });
        }

        window.open(url, '_blank', 'noopener,noreferrer');
      });
    })();
  </script>
</BaseLayout>
