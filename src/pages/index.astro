---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FaqSchema from '../components/FaqSchema.astro';
import { site, whatsappLink, mailtoLink } from '../data/site';

const title = "Men's Salon in Doha, Qatar | Tamara Men Salon — Haircuts & Hot Towel Shaves";
const description =
  "Top-rated men's salon in Doha, Qatar on B Ring Road. Precision haircuts, hot towel shaves, beard sculpting and grooming — book online or walk in. Open Mon–Sat 9 AM–8 PM.";
const keywords =
  "men's salon Doha, barbershop Qatar, haircut Doha, hot towel shave, beard trim Doha, barber B Ring Road, men's grooming Qatar, kids haircut Doha, straight razor shave, Tamara Men Salon";

const faqs = [
  {
    q: 'Where is Tamara Men Salon located in Doha?',
    a: "Tamara Men Salon is on B Ring Road, Street 220, Building 100, Zone 15, Unit 1 in Al Doha Jadeed, Doha, Qatar. Plus code 7GGM+2X6.",
  },
  {
    q: 'What are your opening hours?',
    a: 'We are open Monday to Saturday from 9 AM to 8 PM, and Sunday from 9 AM to 6 PM. Walk-ins are welcome any time we are open.',
  },
  {
    q: 'Do you accept walk-ins or do I need an appointment?',
    a: 'Walk-ins are always welcome. To guarantee your preferred time and barber, book through our online form or message us on WhatsApp.',
  },
  {
    q: 'How do I book an appointment at Tamara Men Salon?',
    a: 'Use the booking form on this page or send us a WhatsApp message at +974 7077 5905 with your preferred service, date and time. We confirm bookings within minutes.',
  },
  {
    q: 'What services do you offer?',
    a: "We offer precision haircuts (classic, deluxe, buzz, and kids' cuts), hot towel straight razor shaves, beard trims and sculpting, mustache trims, hair color, full facials and hair wash & blow services for men.",
  },
  {
    q: 'How much does a haircut cost?',
    a: "Pricing is honest and flat-rate in Qatari Riyal (QAR). Classic cuts start from QAR 15 (buzz) and QAR 25 (classic). Deluxe haircuts and hot towel shaves are QAR 35. See the full pricing menu on this page.",
  },
  {
    q: 'Do you cut kids hair?',
    a: "Yes. We offer kids' haircuts at QAR 20 and our barbers are great with little clients.",
  },
  {
    q: 'Are you the best men salon in Doha?',
    a: "Our clients tell us we're up there. We carry a 5.0★ rating on Google with dozens of reviews and earn it daily through careful work and a friendly chair-side experience.",
  },
];

const pricing = [
  {
    key: 'Haircuts',
    keyAr: 'القصات',
    image: 'https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=800&q=80&auto=format&fit=crop',
    items: [
      { name: 'Classic Cut', nameAr: 'قصة كلاسيكية', price: '25' },
      { name: 'Deluxe Cut', nameAr: 'قصة فاخرة', price: '35' },
      { name: 'Buzz Cut', nameAr: 'قصة قصيرة', price: '15' },
      { name: "Kids' Cut", nameAr: 'قصة للأطفال', price: '20' },
    ],
  },
  {
    key: 'Shaving',
    keyAr: 'الحلاقة',
    image: 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=800&q=80&auto=format&fit=crop',
    items: [
      { name: 'Beard Trim', nameAr: 'تشذيب اللحية', price: '20' },
      { name: 'Hot Towel Shave', nameAr: 'حلاقة بالمنشفة الساخنة', price: '35' },
      { name: 'Straight Razor Trim', nameAr: 'حلاقة بموس مستقيم', price: '25' },
      { name: 'Mustache Trim', nameAr: 'تشذيب الشارب', price: '15' },
    ],
  },
  {
    key: 'Styling',
    keyAr: 'التصفيف',
    image: 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=800&q=80&auto=format&fit=crop',
    items: [
      { name: 'Hair Color', nameAr: 'صبغة الشعر', price: '25' },
      { name: 'Full Facial', nameAr: 'تنظيف بشرة كامل', price: '35' },
      { name: 'Neck Trim', nameAr: 'تشذيب الرقبة', price: '15' },
      { name: 'Hair Wash & Blow', nameAr: 'غسيل وتجفيف', price: '20' },
    ],
  },
] as const;

const team = [
  {
    name: 'Leon Curry',
    role: 'Master Barber',
    image: 'https://images.unsplash.com/photo-1620331311520-246422fd82f9?w=800&q=80&auto=format&fit=crop',
  },
  {
    name: 'Anthony Huff',
    role: 'Senior Stylist',
    image: 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=800&q=80&auto=format&fit=crop',
  },
  {
    name: 'Ben Parker',
    role: 'Beard Specialist',
    image: 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=800&q=80&auto=format&fit=crop',
  },
];

const gallery = [
  'https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=900&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1585747860715-2ba37e788b70?w=900&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=900&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=900&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=900&q=80&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1593702275687-f8b402bf1fb5?w=900&q=80&auto=format&fit=crop',
];
---
<BaseLayout title={title} description={description} keywords={keywords}>
  <FaqSchema items={faqs} slot="head" />

  <!-- HERO -->
  <section id="home" class="relative overflow-hidden bg-cream-50">
    <div class="absolute inset-0 -z-10 bg-grain opacity-30"></div>
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 lg:pt-24 lg:pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-7 text-center lg:text-left">
          <p class="eyebrow" data-i18n-en="Shaves & Trims" data-i18n-ar="حلاقة وتشذيب">Shaves &amp; Trims</p>
          <span data-lang="en">
            <h1 class="mt-4 font-condensed uppercase font-bold tracking-tight text-charcoal-800 text-5xl sm:text-6xl lg:text-7xl xl:text-[88px] leading-[0.95]">
              We Know Your<br /><span class="text-gold-500">Style</span> Better
            </h1>
          </span>
          <span data-lang="ar">
            <h1 class="mt-4 font-condensed uppercase font-bold tracking-tight text-charcoal-800 text-5xl sm:text-6xl lg:text-7xl xl:text-[88px] leading-[1.1]">
              نحن نعرف <span class="text-gold-500">ستايلك</span><br />أفضل من أي أحد
            </h1>
          </span>
          <p class="mt-4 max-w-xl text-base text-charcoal-700 font-display italic mx-auto lg:mx-0" data-i18n-en="Doha's top-rated men's salon on B Ring Road" data-i18n-ar="صالون رجالي رائد على طريق الدائري ب، الدوحة">
            Doha's top-rated men's salon on B Ring Road
          </p>
          <p class="mt-4 max-w-xl text-base sm:text-lg text-ink-soft font-sans leading-relaxed mx-auto lg:mx-0" data-i18n-en="Step into Tamara Men Salon for a tailored grooming experience — sharp haircuts, hot towel shaves, and beard styling delivered by master barbers in the heart of Doha, Qatar." data-i18n-ar="تفضل إلى صالون تمارا للرجال لتجربة عناية فاخرة — قصات دقيقة، حلاقة بالمناشف الساخنة، وتنسيق اللحية على يد أمهر الحلاقين في قلب الدوحة، قطر.">
            Step into Tamara Men Salon for a tailored grooming experience — sharp haircuts, hot towel shaves,
            and beard styling delivered by master barbers in the heart of Doha, Qatar.
          </p>

          <!-- Google rating badge (compact, in hero) -->
          <a
            href={site.social.googleReview}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center gap-2.5 px-3 py-2 border border-gold-500/40 bg-white/60 hover:border-gold-500 transition-colors"
          >
            <span class="text-gold-500 text-base leading-none tracking-tight" aria-hidden="true">★★★★★</span>
            <span class="font-condensed uppercase tracking-widest text-[11px] text-charcoal-700">
              <span class="font-bold text-gold-600">{site.rating.score}</span>
              <span data-i18n-en={` on Google · ${site.rating.count}+ reviews`} data-i18n-ar={` على Google · ${site.rating.count}+ تقييم`}>
                {' '}on Google · {site.rating.count}+ reviews
              </span>
            </span>
          </a>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center justify-center lg:justify-start">
            <a href="#book" class="btn-primary">
              <span data-i18n-en="Make an Appointment" data-i18n-ar="احجز موعدك">Make an Appointment</span>
              <Icon name="arrowRight" size={16} class="rtl-flip" />
            </a>
            <a href="#pricing" class="btn-outline-dark" data-i18n-en="View Pricing" data-i18n-ar="قائمة الأسعار">View Pricing</a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative aspect-[4/5] w-full max-w-md mx-auto">
            <div class="absolute -inset-3 border border-gold-500"></div>
            <img
              src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=900&q=85&auto=format&fit=crop"
              alt="Master barber giving a precision men's haircut at Tamara Men Salon in Doha, Qatar"
              width="900"
              height="1125"
              class="relative h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div class="mt-16 grid sm:grid-cols-3 gap-px bg-gold-500/30 border border-gold-500/30">
        <div class="bg-cream-50 px-6 py-7 flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-gold-500 text-gold-500">
            <Icon name="mapPin" size={22} />
          </span>
          <div>
            <p class="font-condensed uppercase tracking-widest text-xs text-ink-muted" data-i18n-en="Address" data-i18n-ar="العنوان">Address</p>
            <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 block font-display text-lg text-charcoal-700 hover:text-gold-600" data-i18n-en="B Ring Road, Doha" data-i18n-ar="طريق الدائري ب، الدوحة">
              B Ring Road, Doha
            </a>
            <p class="text-sm text-ink-soft" data-i18n-en={`${site.address.neighbourhood} · Zone 15`} data-i18n-ar="الدوحة الجديدة · منطقة 15">{site.address.neighbourhood} · Zone 15</p>
          </div>
        </div>
        <div class="bg-cream-50 px-6 py-7 flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-gold-500 text-gold-500">
            <Icon name="phone" size={22} />
          </span>
          <div>
            <p class="font-condensed uppercase tracking-widest text-xs text-ink-muted" data-i18n-en="Phone" data-i18n-ar="الهاتف">Phone</p>
            <a href={`tel:${site.phoneIntl}`} class="mt-1 block font-display text-lg text-charcoal-700 hover:text-gold-600" dir="ltr">
              {site.phone}
            </a>
            <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-soft hover:text-gold-600" data-i18n-en="WhatsApp us" data-i18n-ar="راسلنا عبر واتساب">WhatsApp us</a>
          </div>
        </div>
        <div class="bg-cream-50 px-6 py-7 flex items-start gap-4">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-gold-500 text-gold-500">
            <Icon name="clock" size={22} />
          </span>
          <div>
            <p class="font-condensed uppercase tracking-widest text-xs text-ink-muted" data-i18n-en="Hours" data-i18n-ar="ساعات العمل">Hours</p>
            <p class="mt-1 font-display text-base text-charcoal-700" data-i18n-en={site.hoursDisplay.weekdays} data-i18n-ar="الإثنين–السبت: 9ص – 8م">{site.hoursDisplay.weekdays}</p>
            <p class="text-sm text-ink-soft" data-i18n-en={site.hoursDisplay.weekend} data-i18n-ar="الأحد: 9ص – 6م">{site.hoursDisplay.weekend}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="bg-charcoal-800 text-cream-100 py-20 lg:py-28">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-3">
            <img
              src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=600&q=80&auto=format&fit=crop"
              alt="Classic barber chair inside Tamara Men Salon, B Ring Road Doha"
              width="600"
              height="800"
              class="aspect-[3/4] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <img
              src="https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?w=600&q=80&auto=format&fit=crop"
              alt="Professional barber tools — clippers, straight razor and combs at Tamara Men Salon Doha"
              width="600"
              height="800"
              class="aspect-[3/4] w-full object-cover translate-y-8"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="lg:col-span-7">
          <p class="eyebrow" data-i18n-en="About Us" data-i18n-ar="من نحن">About Us</p>
          <span data-lang="en">
            <h2 class="mt-3 font-condensed uppercase font-bold tracking-wide text-cream-50 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]">
              A New Standard for<br />Men's Grooming in Doha
            </h2>
          </span>
          <span data-lang="ar">
            <h2 class="mt-3 font-condensed uppercase font-bold tracking-wide text-cream-50 text-3xl sm:text-4xl lg:text-5xl leading-[1.15]">
              معيار جديد للعناية<br />الرجالية في الدوحة
            </h2>
          </span>
          <p class="mt-6 text-cream-100/80 leading-relaxed">
            Tamara Men Salon opened its doors on B Ring Road in <span class="text-gold-400">{site.established}</span> with one promise — give the men of Doha a
            place where every haircut is treated like a portrait, and every client like a regular. From classic
            straight razor shaves to modern fades and beard sculpting, our chairs are reserved for craftsmen who
            care about the details.
          </p>
          <p class="mt-4 text-cream-100/70 leading-relaxed">
            Walk into our shop and you'll find the smell of bay rum, the hum of clippers, hot towels on the warmer,
            and an unhurried welcome. We don't rush. We listen. Then we work.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#services" class="btn-outline-light" data-i18n-en="Our Services" data-i18n-ar="خدماتنا">Our Services</a>
            <a href="#gallery" class="btn-outline-light" data-i18n-en="Our Gallery" data-i18n-ar="معرضنا">Our Gallery</a>
            <a href="#pricing" class="btn-outline-light" data-i18n-en="Our Pricing" data-i18n-ar="أسعارنا">Our Pricing</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="bg-cream-50 py-20 lg:py-24">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow" data-i18n-en="What We Offer" data-i18n-ar="ماذا نقدم">What We Offer</p>
        <h2 class="mt-3 h-section" data-i18n-en="Signature Services" data-i18n-ar="خدماتنا المميزة">Signature Services</h2>
        <p class="mt-4 text-ink-soft" data-i18n-en="From classic cuts to full grooming experiences — every service is built around what makes you look, and feel, your best." data-i18n-ar="من القصات الكلاسيكية إلى تجارب العناية الكاملة — كل خدمة مصممة لتظهر بأفضل صورة وتشعر بأفضل حال.">
          From classic cuts to full grooming experiences — every service is built around what makes you look,
          and feel, your best.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: 'scissors', title: 'Precision Haircut', titleAr: 'قصة دقيقة', copy: 'Tailored to your face, hair and style — scissor cut, clipper work or a sharp fade.', copyAr: 'مصممة حسب وجهك وشعرك وأسلوبك — مقص، ماكينة، أو تدرّج حاد.' },
          { icon: 'razor', title: 'Hot Towel Shave', titleAr: 'حلاقة بالمنشفة الساخنة', copy: 'Old-school straight razor shave with steamed towels, pre-shave oil and aftershave balm.', copyAr: 'حلاقة كلاسيكية بموس مع مناشف ساخنة، زيت قبل الحلاقة وبلسم بعدها.' },
          { icon: 'beard', title: 'Beard Sculpting', titleAr: 'تنسيق اللحية', copy: 'Trim, line-up and condition. We shape your beard so it frames your jawline cleanly.', copyAr: 'تشذيب، تحديد وترطيب. نشكّل لحيتك لتُبرز ملامح وجهك بوضوح.' },
          { icon: 'comb', title: 'Hair & Skin Care', titleAr: 'عناية الشعر والبشرة', copy: 'Hair color, scalp treatment, full facials and grooming products to take home.', copyAr: 'صبغة الشعر، علاج فروة الرأس، تنظيف بشرة كامل ومنتجات عناية تأخذها معك.' },
        ].map((item) => (
          <article class="group bg-white border border-charcoal-100 p-8 hover:border-gold-500 transition-colors">
            <span class="inline-flex h-14 w-14 items-center justify-center border border-gold-500 text-gold-500 group-hover:bg-gold-500 group-hover:text-cream-50 transition-colors">
              <Icon name={item.icon} size={26} />
            </span>
            <h3 class="mt-5 font-condensed uppercase tracking-wide text-charcoal-800 text-xl" data-i18n-en={item.title} data-i18n-ar={item.titleAr}>{item.title}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed" data-i18n-en={item.copy} data-i18n-ar={item.copyAr}>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="bg-charcoal-700 py-20 lg:py-24">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-end mb-12">
        <div class="lg:col-span-7">
          <p class="eyebrow" data-i18n-en="Our Work" data-i18n-ar="أعمالنا">Our Work</p>
          <h2 class="mt-3 font-condensed uppercase font-bold tracking-wide text-cream-50 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]" data-i18n-en="Discover Our Works" data-i18n-ar="اكتشف أعمالنا">
            Discover Our Works
          </h2>
        </div>
        <div class="lg:col-span-5 text-cream-100/75">
          <p data-i18n-en="A snapshot of recent cuts, shaves and styling from the chairs at Tamara Men Salon." data-i18n-ar="لمحة عن أحدث القصات والحلاقات والتسريحات من كراسي صالون تمارا للرجال.">A snapshot of recent cuts, shaves and styling from the chairs at Tamara Men Salon.</p>
        </div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {gallery.map((src, i) => (
          <a href={src} target="_blank" rel="noopener noreferrer" class="group relative overflow-hidden block">
            <img
              src={src}
              alt={`Men's haircut and grooming work ${i + 1} at Tamara Men Salon, Doha Qatar`}
              width="900"
              height="900"
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute inset-0 bg-charcoal-900/0 group-hover:bg-charcoal-900/40 transition-colors flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 text-gold-400 font-condensed uppercase tracking-widest text-sm transition-opacity">View</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section id="team" class="bg-cream-50 py-20 lg:py-24">
    <div class="max-w-container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow" data-i18n-en="Meet the Crew" data-i18n-ar="تعرف على الفريق">Meet the Crew</p>
        <h2 class="mt-3 h-section" data-i18n-en="Master Barbers" data-i18n-ar="حلاقون محترفون">Master Barbers</h2>
        <p class="mt-4 text-ink-soft" data-i18n-en="A handpicked team trained in classic technique and modern styling — each barber brings years of craft to the chair." data-i18n-ar="فريق مختار بعناية، يجمع بين الأسلوب الكلاسيكي والحديث — كل حلاق يجلب سنوات من الخبرة إلى الكرسي.">
          A handpicked team trained in classic technique and modern styling — each barber brings years of craft
          to the chair.
        </p>
      </div>

      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map((member) => (
          <article class="group text-center">
            <div class="relative overflow-hidden">
              <img
                src={member.image}
                alt={`${member.name} — ${member.role} at Tamara Men Salon, Doha`}
                width="800"
                height="1067"
                class="aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-x-4 bottom-4 flex items-center justify-center gap-2 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all">
                <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="inline-flex h-10 w-10 items-center justify-center bg-cream-50/95 text-charcoal-800 hover:bg-gold-500 hover:text-cream-50 transition-colors">
                  <Icon name="instagram" size={18} />
                </a>
