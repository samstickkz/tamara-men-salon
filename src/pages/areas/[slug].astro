---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bubbles from '../../components/Bubbles.astro';
import Icon from '../../components/Icon.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import AreaCard from '../../components/AreaCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PageHero from '../../components/PageHero.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { areas, type Area } from '../../data/areas';
import { areaBody } from '../../data/areaContent';
import { services } from '../../data/services';

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props { area: Area }
const { area } = Astro.props;

const body = areaBody[area.slug] ?? '';
const others = areas.filter((a) => a.slug !== area.slug);
const featuredServices = services.slice(0, 6);
const msg = `Hello Tamara Cleaning, I'd like a quote for cleaning in ${area.name}.`;
---
<BaseLayout title={area.metaTitle} description={area.metaDescription}>
  <BreadcrumbSchema
    slot="head"
    items={[
      { name: 'Home', href: '/' },
      { name: 'Areas', href: '/areas/doha' },
      { name: area.name, href: `/areas/${area.slug}` },
    ]}
  />

  <PageHero
    eyebrow={`${area.name}, Qatar`}
    title={`Cleaning Services in ${area.name}`}
    intro={area.blurb}
    iconName="mapPin"
    crumbs={[
      { name: 'Home', href: '/' },
      { name: 'Services', href: '/services' },
      { name: `Cleaning in ${area.name}` },
    ]}
  >
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <WhatsAppButton variant="inverse" size="lg" label={`Book ${area.name} cleaning`} message={msg} />
      <a
        href="/services"
        class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-accent-500 hover:bg-accent-400 text-ink font-bold uppercase tracking-wide text-sm shadow-md transition-colors"
      >
        See All Services
        <Icon name="arrowRight" size={16} />
      </a>
    </div>
  </PageHero>

  <!-- Highlights strip -->
  <section class="relative -mt-16 sm:-mt-20 z-10">
    <div class="container-page">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 p-2 bg-white rounded-2xl shadow-2xl">
        {
          area.highlights.map((h) => (
            <li class="flex items-start gap-3 p-4 rounded-xl hover:bg-brand-50 transition-colors">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-500 text-ink">
                <Icon name="check" size={16} />
              </span>
              <span class="text-sm font-semibold text-ink">{h}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Body -->
  <section class="relative isolate py-16 sm:py-20 bg-white">
    <div class="container-page relative grid gap-12 lg:grid-cols-[1.6fr_1fr]">
      <article class="prose-clean" set:html={body}></article>
      <aside class="space-y-5 lg:sticky lg:top-32 lg:self-start">
        <div class="relative overflow-hidden p-6 rounded-2xl bg-brand-600 text-white shadow-xl">
          <Bubbles class="absolute -top-10 -right-10 w-[320px] h-[400px]" variant="light" />
          <Bubbles class="absolute -bottom-12 -left-10 w-[240px] h-[320px]" variant="light" />
          <div class="relative">
            <h2 class="font-display text-xl font-bold">Book {area.name} cleaning</h2>
            <p class="mt-2 text-white/90 text-sm">
              Share a few photos of the property on WhatsApp and we will respond with a flat-rate quote.
            </p>
            <div class="mt-4">
              <WhatsAppButton variant="inverse" full label={`Message us about ${area.name}`} message={msg} />
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="relative isolate py-16 bg-slate-50">
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Popular in this area"
        title={`The services ${area.name} customers book most`}
        intro="Combine multiple services in a single visit — common for first-time customers."
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredServices.map((s) => (
            <ServiceCard
              href={`/services/${s.slug}`}
              title={s.shortTitle}
              description={s.tagline}
              icon={s.icon}
            />
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <a
          href="/services"
          class="inline-flex items-center gap-2 text-brand-700 font-bold hover:gap-3 transition-all"
        >
          See all 11 services
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
    </div>
  </section>

  <section class="relative isolate py-16 sm:py-20 bg-white">
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Other areas"
        title="Cleaning across the rest of Qatar"
      />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((a) => (
            <AreaCard href={`/areas/${a.slug}`} name={a.name} description={a.blurb} />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner
    title={`Book a cleaning visit in ${area.name}`}
    subtitle="We will respond on WhatsApp within hours during opening times."
  />
</BaseLayout>
