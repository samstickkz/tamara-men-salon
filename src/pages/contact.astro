---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bubbles from '../components/Bubbles.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PageHero from '../components/PageHero.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { site, mailtoLink } from '../data/site';
import { services } from '../data/services';

const title = 'Contact Tamara Cleaning Services | Doha, Qatar';
const description = `Contact Tamara Cleaning Services in Doha, Qatar on WhatsApp, email, or via our quick contact form. CR ${site.cr}. Booking response within hours.`;
---
<BaseLayout title={title} description={description}>
  <BreadcrumbSchema
    slot="head"
    items={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }]}
  />

  <PageHero
    eyebrow="Get In Touch"
    title="Get a quote in minutes"
    intro="The fastest route is WhatsApp — share a few photos and we will price the job on the spot. Or use the form below and we will reply by email."
    iconName="whatsapp"
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact' }]}
  >
    <div class="mt-8">
      <WhatsAppButton variant="inverse" size="lg" label="Open WhatsApp chat" />
    </div>
  </PageHero>

  <!-- Contact info cards floating over divider -->
  <section class="relative -mt-16 sm:-mt-20 z-10">
    <div class="container-page">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 p-2 bg-white rounded-2xl shadow-2xl">
        <a href={`tel:${site.phoneIntl}`} class="flex flex-col items-start gap-3 p-5 rounded-xl hover:bg-brand-50 transition-colors group">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-600 text-white group-hover:bg-accent-500 group-hover:text-ink transition-colors">
            <Icon name="phone" size={20} />
          </span>
          <div>
            <p class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Phone</p>
            <p class="font-bold text-ink">{site.phone}</p>
          </div>
        </a>
        <a href={mailtoLink('Cleaning quote request')} class="flex flex-col items-start gap-3 p-5 rounded-xl hover:bg-brand-50 transition-colors group">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-600 text-white group-hover:bg-accent-500 group-hover:text-ink transition-colors">
            <Icon name="email" size={20} />
          </span>
          <div>
            <p class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Email</p>
            <p class="font-bold text-ink">{site.email}</p>
          </div>
        </a>
        <div class="flex flex-col items-start gap-3 p-5 rounded-xl">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-600 text-white">
            <Icon name="mapPin" size={20} />
          </span>
          <div>
            <p class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Office</p>
            <p class="font-bold text-ink">Doha, Qatar</p>
          </div>
        </div>
        <div class="flex flex-col items-start gap-3 p-5 rounded-xl">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-brand-600 text-white">
            <Icon name="clock" size={20} />
          </span>
          <div>
            <p class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Hours</p>
            <p class="font-bold text-ink text-sm">Sat–Thu 08:00–20:00<br/>Fri 14:00–20:00</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Form + sidebar -->
  <section class="relative isolate py-16 sm:py-24 bg-white">
    <div class="container-page relative grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <aside class="space-y-5">
        <div class="relative overflow-hidden p-6 sm:p-8 rounded-2xl bg-brand-600 text-white shadow-xl">
          <Bubbles class="absolute -top-10 -right-10 w-[320px] h-[400px]" variant="light" />
          <Bubbles class="absolute -bottom-12 -left-10 w-[240px] h-[320px]" variant="light" />
          <div class="relative">
            <p class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] font-semibold text-accent-300">
              <span class="inline-block h-px w-8 bg-accent-300"></span>
              Quickest Route
            </p>
            <h2 class="mt-3 font-display text-2xl font-bold">WhatsApp us</h2>
            <p class="mt-2 text-white/90 text-sm leading-relaxed">
              Send a couple of photos of the space and your area. We reply with a flat-rate quote
              — usually within an hour during opening times.
            </p>
            <div class="mt-5">
              <WhatsAppButton variant="inverse" full label="Open WhatsApp" />
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <h3 class="font-display text-base font-bold text-ink uppercase tracking-wide">Commercial Registration</h3>
          <dl class="mt-4 space-y-2 text-sm">
            <div><dt class="font-medium text-ink-muted">CR Number</dt><dd class="text-ink">CR {site.cr}</dd></div>
            <div><dt class="font-medium text-ink-muted">Legal form</dt><dd class="text-ink">Limited Liability Company (One Person)</dd></div>
            <div><dt class="font-medium text-ink-muted">Owner</dt><dd class="text-ink">{site.owner}</dd></div>
            <div><dt class="font-medium text-ink-muted">Established</dt><dd class="text-ink">{site.established}</dd></div>
          </dl>
        </div>
      </aside>

      <div class="relative overflow-hidden p-6 sm:p-10 bg-white rounded-2xl border border-slate-200 shadow-lg">
        <h2 class="font-display text-2xl font-bold text-ink">Send us a message</h2>
        <p class="mt-2 text-ink-soft">
          Tell us about your space and we will come back with a quote. All fields marked * are required.
        </p>

        <form
          name="contact"
          method="POST"
          action="/api/submit"
          class="mt-6 grid gap-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Full name *</span>
              <input
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
              />
            </label>
            <label class="block">
              <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Phone / WhatsApp *</span>
              <input
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="+974 ..."
                class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
              />
            </label>
          </div>

          <label class="block">
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Email *</span>
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
            />
          </label>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Service</span>
              <select
                name="service"
                class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
              >
                <option value="">Choose a service</option>
                {services.map((s) => <option value={s.shortTitle}>{s.shortTitle}</option>)}
                <option value="Other">Something else</option>
              </select>
            </label>
            <label class="block">
              <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">Area / neighbourhood</span>
              <input
                name="area"
                type="text"
                placeholder="e.g. The Pearl, Lusail, Al Waab"
                class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
              />
            </label>
          </div>

          <label class="block">
            <span class="text-xs font-semibold text-ink-muted uppercase tracking-wider">How can we help? *</span>
            <textarea
              name="message"
              rows="5"
              required
              placeholder="Tell us about the space — size, bedrooms, condition, preferred date."
              class="mt-1.5 block w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-ink focus:border-brand-600 focus:ring-2 focus:ring-brand-100 outline-none"
            ></textarea>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-accent-500 hover:bg-accent-400 text-ink font-bold uppercase tracking-wide text-sm shadow-md transition-colors"
          >
            Send Message
            <Icon name="arrowRight" size={18} />
          </button>

          <p class="text-xs text-ink-muted">
            By submitting, you agree to be contacted by Tamara Cleaning Services about your enquiry.
            We never share your details.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
